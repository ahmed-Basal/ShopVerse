    },
    "schemas": {
      "SignupRequest": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Ahmed Saad"
          },
          "email": {
            "type": "string",
            "example": "ahmed.test@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "example": "ahmed.test@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        }
      },
      "Permission": {
        "type": "object",
        "required": ["route"],
        "properties": {
          "route": {
            "type": "string",
            "description": "The exact route path template (e.g. '/api/v1/products/:id') or '*' for all routes.",
            "example": "/api/v1/products/:id"
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["GET", "POST", "PUT", "DELETE", "PATCH", "*"]
            },
            "example": ["GET", "DELETE"]
          }
        }
      },
      "ApiKeyRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Production Mobile App Key"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2027-12-31T23:59:59.000Z"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "ApiKey": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "6a54887efea30afcc00a5458"
          },
          "key": {
            "type": "string",
            "example": "api_key_e2c00aa28b1179b6809af1c16f26ee31e241efd92b4d8693"
          },
          "name": {
            "type": "string",
            "example": "Production Mobile App Key"
          },
          "user": {
            "type": "string",
            "example": "6a53a1588a30e74e80b2d081"
          },
          "isActive": {
            "type": "boolean",
            "example": true
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProductRequest": {
        "type": "object",
        "required": ["title", "description", "quantity", "price", "category"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Adidas Ultraboost"
          },
          "description": {
            "type": "string",
            "example": "Premium sports shoes with boost technology."
          },
          "quantity": {
            "type": "integer",
            "example": 100
          },
          "price": {
            "type": "number",
            "example": 180
          },
          "category": {
            "type": "string",
            "example": "61b2a9d869d54640ca3d7293"
          },
          "brand": {
            "type": "string",
            "example": "61b2a9d869d54640ca3d7294"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Electronics"
          }
        }
      },
      "SubcategoryRequest": {
        "type": "object",
        "required": ["name", "category"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Smartphones"
          },
          "category": {
            "type": "string",
            "example": "61b2a9d869d54640ca3d7293"
          }
        }
      }
    }
  }
}
