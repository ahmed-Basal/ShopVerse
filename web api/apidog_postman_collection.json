    {
      "name": "API Keys",
      "item": [
        {
          "name": "Create API Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{JWT_TOKEN}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Mobile App Read-Only Key\",\n  \"expiresAt\": \"2027-12-31T23:59:59.000Z\",\n  \"permissions\": [\n    {\n      \"route\": \"/api/v1/products\",\n      \"methods\": [\"GET\"]\n    },\n    {\n      \"route\": \"/api/v1/categories\",\n      \"methods\": [\"GET\"]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/apikeys",
              "host": ["{{BASE_URL}}"],
              "path": ["apikeys"]
            }
          }
        },
        {
          "name": "Get my API Keys",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{JWT_TOKEN}}", "type": "string" }]
            },
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/apikeys",
              "host": ["{{BASE_URL}}"],
              "path": ["apikeys"]
            }
          }
        },
        {
          "name": "Delete API Key",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{JWT_TOKEN}}", "type": "string" }]
